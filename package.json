{
  "name": "internetplace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:netlify": "npx --yes netlify-cli dev",
    "data:prepare": "node scripts/prepare-secc-state-summary.mjs",
    "data:trains": "node scripts/prepare-sealdah-network.mjs",
    "data:trains:west-bengal": "node scripts/prepare-west-bengal-trains.mjs",
    "build": "npm run data:prepare && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "mdsvex": "^0.12.3",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "gtfs-realtime-bindings": "^2.2.0",
    "leaflet": "^1.9.4"
  }
}
